<?xml version="1.0"?>
<package format="2">
  <name>hw2</name>
  <version>0.1.0</version>
  <description>
     Qt-based GUI to teleoperate turtlesim over ROS 2: WASD movement,
     triangle/square/circle shape drawing, adjustable pen thickness,
     and a togglable color palette.
  </description>
  <maintainer email="author@mail.com">author</maintainer>
  <author>author</author>
  <license>BSD</license>
  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>turtlesim</depend>
  <depend>std_srvs</depend>
  <depend>libqt5-core</depend>
  <depend>libqt5-gui</depend>
  <depend>libqt5-widgets</depend>
  <depend>libqt5-network</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
